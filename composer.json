{
	"name": "dd32/wp-user-teams",
	"description": "Unix-style user groups for WordPress — exposed as \"Teams\" in the admin.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^3.0"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"composer/installers": true
		},
		"audit": {
			"abandoned": "ignore",
			"ignore": [
				"PKSA-5jz8-6tcw-pbk4",
				"PKSA-z3gr-8qht-p93v"
			]
		}
	}
}
