<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
>
	<php>
		<const name="WP_TESTS_MULTISITE" value="1" />
	</php>
	<testsuites>
		<testsuite name="user-groups-multisite">
			<directory suffix=".php">tests</directory>
		</testsuite>
	</testsuites>
</phpunit>
